// Who signs the app and which ids it uses. Every target reads these, and the app reads the ids
// back at run time (Info.plist keys KDLAppId and KDLAppGroup).
//
// Do not edit this file. Copy Local.example.xcconfig to Local.xcconfig (ignored by git) and set
// your own prefix and team there. The team is left empty here on purpose: without Local.xcconfig,
// Xcode stops with "requires a development team" instead of signing with someone else's.
KDL_ID_PREFIX = com.abrignoni
DEVELOPMENT_TEAM =

KDL_APP_ID = $(KDL_ID_PREFIX).knowndatalogger
KDL_APP_GROUP = group.$(KDL_ID_PREFIX).knowndatalogger

#include? "Local.xcconfig"
