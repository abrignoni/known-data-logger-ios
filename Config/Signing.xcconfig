// Who signs the app and which ids it uses. Every target reads these, and the app reads the ids
// back at run time (Info.plist keys KDLAppId and KDLAppGroup), so changing them here is enough.
//
// To build KDL with your own Apple ID, do not edit this file: copy Local.example.xcconfig to
// Local.xcconfig (ignored by git) and set your own values there.
KDL_ID_PREFIX = com.abrignoni
DEVELOPMENT_TEAM = 33DUL485L9

KDL_APP_ID = $(KDL_ID_PREFIX).knowndatalogger
KDL_APP_GROUP = group.$(KDL_ID_PREFIX).knowndatalogger

#include? "Local.xcconfig"
